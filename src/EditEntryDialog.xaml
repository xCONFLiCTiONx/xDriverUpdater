<Window x:Class="xDriverUpdater.EditEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Entry" Height="540" Width="580" MinHeight="440" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="DialogTitleText" Text="Edit Entry" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="DialogSubtitleText" Text="Modify shortcut display name and group location" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Form fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Display Name" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

                <StackPanel x:Name="GroupPanel" Margin="0,0,0,14">
                    <TextBlock Text="Win+X Group" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="GroupComboBox">
                        <ComboBoxItem Content="Group 1 (Bottom - next to Start button)" Tag="Group1"/>
                        <ComboBoxItem Content="Group 2 (Middle - File tools &amp; Explorer)" Tag="Group2"/>
                        <ComboBoxItem Content="Group 3 (Top - Administration utilities)" Tag="Group3" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="TargetLabelText" Text="Target Path" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox" Margin="0,0,8,0"/>
                    <Button x:Name="BrowseTargetButton" Grid.Column="1" Content="Browse..." Click="BrowseTarget_Click"/>
                </Grid>

                <StackPanel x:Name="ArgumentsPanel" Margin="0,0,0,14">
                    <TextBlock x:Name="ArgumentsLabelText" Text="Command Arguments (optional)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="ArgumentsBox"/>
                </StackPanel>

                <StackPanel x:Name="AdminPanel" Margin="0,0,0,14">
                    <CheckBox x:Name="RunAsAdminCheckBox" Content="Run with administrator privileges (SLDF_RUNAS_USER)"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Explorer notice for Win+X -->
        <Border x:Name="WinXNoticeBorder" Grid.Row="2" Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,16">
            <TextBlock Text="Windows 11 24H2 locks Win+X targets to the 17 built-in system shortcuts (twinui.pcshell.dll hash whitelist), while allowing you to rename entries, move them between groups, and enable/disable them. Restart Explorer after saving."
                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11"/>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
