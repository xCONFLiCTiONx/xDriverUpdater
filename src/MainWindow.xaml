<Window x:Class="xDriverUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xSecurityCenter — All-in-One Windows Security &amp; System Suite"
        Icon="pack://application:,,,/xSecurityCenter;component/icon.ico"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource AppText}"
        Width="1220" Height="740"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid Background="{StaticResource AppBackground}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ==================== PERSISTENT NAVIGATION DRAWER (xBackup + xPrivacyGuard style) ==================== -->
    <Border Grid.Column="0" Background="{StaticResource DrawerBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Padding="15,18">
      <DockPanel LastChildFill="True">
        <!-- Top Brand Header & Protection Pill -->
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="3,0,3,14" VerticalAlignment="Center">
            <Border x:Name="BrandIconBorder" Width="40" Height="40" CornerRadius="12"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1.2"
                    Padding="5" Margin="0,0,11,0">
              <Image Source="pack://application:,,,/xSecurityCenter;component/icon.ico" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="xSecurityCenter" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppText}"/>
              <TextBlock Text="S E C U R I T Y   S U I T E" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>

          <!-- Live Protection Status Pill -->
          <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="2,0,2,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="DrawerStatusDot" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBlock x:Name="DrawerStatusText" Grid.Column="1" Text="Monitoring" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="BG" Grid.Column="2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
          </Border>

          <Border Height="1" Background="{StaticResource PanelBorder}" Margin="2,0,2,12"/>
        </StackPanel>

        <!-- Bottom Live Watchdog Card -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="2,12,2,0">
          <StackPanel>
            <TextBlock x:Name="DrawerPgStatusText" Text="xPrivacyGuard: Checking..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DrawerNetStatusText" Text="Network: Checking..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DrawerDriveStatusText" Text="Drives: Scanning..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Administrator • Tray Active" FontSize="9.5" Foreground="{StaticResource Accent}" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>

        <!-- Navigation Destinations -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Nav_Checked" Tag="Dashboard">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M12,2 L4,5 L4,11 C4,16.55 7.41,21.74 12,23 C16.59,21.74 20,16.55 20,11 L20,5 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                <TextBlock Text="Security Center" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="NavNetwork" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Network">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M4,12 H20 M12,2 C14.5,5 15.5,8.5 15.5,12 C15.5,15.5 14.5,19 12,22 C9.5,19 8.5,15.5 8.5,12 C8.5,8.5 9.5,5 12,2 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      StrokeThickness="1.7" Fill="Transparent"
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                <TextBlock Text="Network &amp; Static IP" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="NavDrives" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Drives">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M2,4 H22 V10 H2 V4 Z M4,6 V8 H6 V6 H4 Z M2,14 H22 V20 H2 V14 Z M4,16 V18 H6 V16 H4 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                <TextBlock Text="Drive Sentinel" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="NavDrivers" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Drivers">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NavDriversLabel" Text="Drivers &amp; Store" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="NavTelemetry" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Telemetry">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M12,1 L3,5 V11 C3,16.55 6.84,21.74 12,23 C17.16,21.74 21,16.55 21,11 V5 L12,1 Z M11,7 H13 V13 H11 V7 Z M11,15 H13 V17 H11 V15 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="NavTelemetryLabel" Text="Telemetry &amp; Debloat" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="NavMonitor" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Monitor">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M4,9 H8 V20 H4 Z M10,4 H14 V20 H10 Z M16,13 H20 V20 H16 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                <TextBlock Text="Live Outbound" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="NavPower" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Power">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M13,2 L4,14 H11 L10,22 L20,10 H13 L13,2 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                <TextBlock Text="Power Plan" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="NavContext" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Context">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M3,6 H21 V8 H3 V6 Z M3,11 H21 V13 H3 V11 Z M3,16 H15 V18 H3 V16 Z"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" VerticalAlignment="Center"/>
                <TextBlock Text="Context &amp; Startup" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ==================== MAIN CONTENT AREA ==================== -->
    <Grid Grid.Column="1" Margin="22,16,22,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Top Page Header -->
      <Grid Grid.Row="0" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitleText" Text="Security Center" FontSize="20" FontWeight="Bold"/>
            <Border x:Name="FormFactorPill" Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="999" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="FormFactorPillText" Text="DETECTING..." FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBright}"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="HeaderSubtitle" Text="Inspecting security posture, xPrivacyGuard, network, drives, and system health..." Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RescanHwBtn" Content="Re-Scan All" Click="RescanHwBtn_Click" Margin="0,0,8,0"/>
          <Button x:Name="ScanUpdatesBtn" Content="Check Driver Updates" Style="{StaticResource SolidAccentButtonStyle}" Click="ScanUpdatesBtn_Click"/>
        </StackPanel>
      </Grid>

      <!-- ==================== VIEW 1: SECURITY CENTER DASHBOARD ==================== -->
      <ScrollViewer x:Name="DashboardView" Grid.Row="1" Visibility="Visible" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Top 3 Security Posture Bento Cards -->
          <UniformGrid Columns="3" Margin="0,0,0,14">
            <!-- xPrivacyGuard Watchdog Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="XPRIVACYGUARD WATCHDOG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                  <Border x:Name="DashPgBadge" HorizontalAlignment="Right" Background="{StaticResource SurfaceRaised}" CornerRadius="999" Padding="8,2">
                    <TextBlock x:Name="DashPgBadgeText" Text="CHECKING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                  </Border>
                </Grid>
                <TextBlock x:Name="DashPgTitle" Text="Checking xPrivacyGuard..." FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DashPgDetail" Text="Verifying VPN process &amp; MASQUE tunnel..." Foreground="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button x:Name="DashLaunchPgBtn" Content="Launch xPrivacyGuard" Style="{StaticResource AccentButtonStyle}" Click="DashLaunchPgBtn_Click" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
                  <Button Content="Recheck" Click="DashCheckPgBtn_Click" Margin="0,0,0,4" Padding="10,5" FontSize="11.5"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Network & Offline Guard Card -->
            <Border Style="{StaticResource CardBorder}" Margin="4,0,4,0">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="NETWORK &amp; OFFLINE GUARD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                  <Border x:Name="DashNetBadge" HorizontalAlignment="Right" Background="{StaticResource SurfaceRaised}" CornerRadius="999" Padding="8,2">
                    <TextBlock x:Name="DashNetBadgeText" Text="CHECKING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                  </Border>
                </Grid>
                <TextBlock x:Name="DashNetTitle" Text="Checking connectivity..." FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DashNetDetail" Text="Offline diagnostics &amp; dual-adapter Static IP ready." Foreground="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="Run Offline Diagnostics" Style="{StaticResource AccentButtonStyle}" Click="DashRunNetDiagBtn_Click" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
                  <Button Content="Static IP Tool" Click="DashOpenNetworkBtn_Click" Margin="0,0,0,4" Padding="10,5" FontSize="11.5"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Drive Sentinel Health Card -->
            <Border Style="{StaticResource CardBorder}" Margin="7,0,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="DRIVE SENTINEL HEALTH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                  <Border x:Name="DashDriveBadge" HorizontalAlignment="Right" Background="{StaticResource SurfaceRaised}" CornerRadius="999" Padding="8,2">
                    <TextBlock x:Name="DashDriveBadgeText" Text="SCANNING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                  </Border>
                </Grid>
                <TextBlock x:Name="DashDriveTitle" Text="Scanning physical drives..." FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DashDriveDetail" Text="NVMe &amp; SATA SMART predictive failure monitoring." Foreground="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="Open Drive Sentinel" Style="{StaticResource AccentButtonStyle}" Click="DashOpenDrivesBtn_Click" Margin="0,0,6,4" Padding="10,5" FontSize="11.5"/>
                  <Button Content="Scan Drives" Click="DriveScanBtn_Click" Margin="0,0,0,4" Padding="10,5" FontSize="11.5"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Platform, Health & Background Guard Row -->
          <UniformGrid Columns="2" Margin="0,0,0,14">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Text="PLATFORM, OEM &amp; DRIVER HEALTH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="CardPlatformTitle" Text="Detecting..." FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2" TextWrapping="Wrap"/>
                <TextBlock x:Name="CardPlatformDetail" Text="" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,10"/>
                <TextBlock x:Name="CardHealthTitle" Text="Scanning drivers..." FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="CardHealthDetail" Text="" Foreground="{StaticResource MutedText}" FontSize="11.5" Margin="0,3,0,8" TextWrapping="Wrap"/>
                <Button x:Name="OpenOemPortalBtn" Content="Open OEM Support Portal" Click="OpenOemPortalBtn_Click" HorizontalAlignment="Left" Padding="10,5" FontSize="11.5"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="7,0,0,0">
              <StackPanel>
                <TextBlock Text="BACKGROUND SECURITY &amp; ENGINE SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkStartWithWindows" Content="Start xSecurityCenter in system tray at Windows logon (elevated)" Margin="0,0,0,6" Checked="SecurityStartupCheck_Changed" Unchecked="SecurityStartupCheck_Changed"/>
                <CheckBox x:Name="ChkMinimizeToTray" Content="Stay running in background (minimize to tray when closed)" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                <CheckBox x:Name="ChkMonitorPrivacyGuard" Content="Alert via tray notification if xPrivacyGuard stops running" Margin="0,0,0,6" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                <CheckBox x:Name="ChkAutoNetDiag" Content="Auto-run offline network diagnostics if internet goes offline" Margin="0,0,0,8" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                <Border Height="1" Background="{StaticResource PanelBorder}" Margin="0,2,0,8"/>
                <CheckBox x:Name="ChkUseWua" Content="Windows Update WHQL Channel" Margin="0,0,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                <CheckBox x:Name="ChkUseDirect" Content="Direct Manufacturer Checks (NVIDIA Live API / Vendor Portals)" Margin="0,0,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                <CheckBox x:Name="ChkUseRepos" Content="Custom &amp; Built-In Driver Repositories" Margin="0,0,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                <CheckBox x:Name="ChkPreferLaptopOem" Content="Prefer OEM / WU drivers on Laptops (OEM Guard)" Margin="0,0,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                <CheckBox x:Name="ChkRestorePoint" Content="Create Restore Point before installing drivers" Margin="0,0,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                <CheckBox x:Name="ChkAutoBackup" Content="Auto-backup current OEM INF driver before replacing" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <!-- Scheduled Silent Updates & xSecurity Alerts Card -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="SCHEDULED SILENT UPDATES &amp; xSECURITY ALERTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ScheduledTaskStatusText" HorizontalAlignment="Right" Text="Checking Windows Task Scheduler..." Foreground="{StaticResource MutedText}" FontSize="11.5"/>
              </Grid>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="95"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="Frequency" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <ComboBox x:Name="SchedFreqCombo">
                    <ComboBoxItem Content="Daily" IsSelected="True"/>
                    <ComboBoxItem Content="Weekly"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                  <TextBlock Text="Time (24h)" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="SchedTimeBox" Text="03:00"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="xServer xSecurity Events Endpoint" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="XSecurityUrlBox"/>
                </StackPanel>
              </Grid>
              <CheckBox x:Name="ChkLocalToastOnFailure" Content="Also show local Windows toast notification on failure" Margin="0,0,0,10" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
              <WrapPanel>
                <Button x:Name="RegisterTaskBtn" Content="Save &amp; Register Scheduled Task" Style="{StaticResource PrimaryButton}" Click="RegisterTaskBtn_Click" Margin="0,0,8,4"/>
                <Button x:Name="RunSilentNowBtn" Content="Run Silent Update Now" Style="{StaticResource SuccessButton}" Click="RunSilentNowBtn_Click" Margin="0,0,8,4"/>
                <Button x:Name="TestAlertBtn" Content="Test xSecurity Alert" Click="TestAlertBtn_Click" Margin="0,0,8,4"/>
                <Button x:Name="OpenLogsFolderBtn" Content="Open Logs Folder" Click="OpenLogsFolderBtn_Click" Margin="0,0,8,4"/>
                <Button x:Name="RemoveTaskBtn" Content="Remove Task" Style="{StaticResource DangerButton}" Click="RemoveTaskBtn_Click" Margin="0,0,0,4"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Smart Audit Findings -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Text="SMART SYSTEM &amp; OEM AUDIT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="AuditSummaryText" HorizontalAlignment="Right" Foreground="{StaticResource MutedText}" FontSize="12"/>
              </Grid>
              <ItemsControl x:Name="AuditList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource DrawerBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="58"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Category, StringFormat='  •  {0}'}" Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ==================== VIEW 2: OFFLINE NETWORK DIAGNOSTICS & STATIC IP ==================== -->
      <ScrollViewer x:Name="NetworkView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Offline Diagnostics Summary & Repair Tools -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <TextBlock Text="OFFLINE NETWORK DIAGNOSTICS (NO AI / INTERNET REQUIRED)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock x:Name="NetDiagLastRunText" HorizontalAlignment="Right" Text="Not run yet" Foreground="{StaticResource MutedText}" FontSize="11.5"/>
              </Grid>
              <TextBlock x:Name="NetDiagHeadlineText" Text="Click 'Run Offline Diagnostics' to test adapters, xPrivacyGuard, router gateway, DNS, and internet routing." FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock x:Name="NetDiagRootCauseText" Text="" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,6" TextWrapping="Wrap"/>
              <Border Background="{StaticResource DrawerBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,2,0,12">
                <StackPanel>
                  <TextBlock Text="OFFLINE RECOVERY STEPS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentBright}" Margin="0,0,0,4"/>
                  <TextBlock x:Name="NetDiagStepsText" Text="Ready to diagnose local network, DHCP, DNS, or VPN issues." Foreground="{StaticResource AppText}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <WrapPanel>
                <Button x:Name="RunNetDiagBtn" Content="Run Offline Diagnostics" Style="{StaticResource SolidAccentButtonStyle}" Click="RunNetDiagBtn_Click" Margin="0,0,8,6"/>
                <Button Content="Flush DNS Cache" Click="NetFlushDnsBtn_Click" Margin="0,0,8,6"/>
                <Button Content="Release &amp; Renew DHCP" Click="NetRenewDhcpBtn_Click" Margin="0,0,8,6"/>
                <Button Content="Restart Network Adapters" Click="NetRestartAdaptersBtn_Click" Margin="0,0,8,6"/>
                <Button Content="Reset Winsock / TCP-IP" Style="{StaticResource DangerButton}" Click="NetResetStackBtn_Click" Margin="0,0,0,6"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Emergency Dual-Adapter Static IP Troubleshooter -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Text="EMERGENCY STATIC IP TROUBLESHOOTER (BOTH ETHERNET &amp; WI-FI ADAPTERS)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <Border x:Name="StaticRollbackBadge" HorizontalAlignment="Right" Background="{StaticResource SurfaceRaised}" CornerRadius="999" Padding="9,3">
                  <TextBlock x:Name="StaticRollbackBadgeText" Text="Normal Mode" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedText}"/>
                </Border>
              </Grid>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Ethernet Static IPv4" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="StaticEthIpBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Wi-Fi Static IPv4" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="StaticWifiIpBox"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Subnet Mask" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="StaticSubnetBox"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Default Gateway (Router)" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="StaticGatewayBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Primary DNS" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="StaticPrimaryDnsBox"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Secondary DNS" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,3"/>
                  <TextBox x:Name="StaticSecondaryDnsBox"/>
                </StackPanel>
              </Grid>

              <WrapPanel>
                <Button x:Name="ApplyStaticBothBtn" Content="Apply Static IP to Both Adapters" Style="{StaticResource SolidAccentButtonStyle}" Click="ApplyStaticBothBtn_Click" Margin="0,0,8,4"/>
                <Button x:Name="RevertStaticBothBtn" Content="Revert Both Adapters (Restore Previous / DHCP)" Style="{StaticResource SuccessButton}" Click="RevertStaticBothBtn_Click" Margin="0,0,8,4"/>
                <Button Content="Auto-Fill from Current Subnet" Click="AutoFillSubnetBtn_Click" Margin="0,0,0,4"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- Diagnostic Checks Table -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14" Padding="12">
            <StackPanel>
              <TextBlock Text="DIAGNOSTIC CHECK RESULTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
              <DataGrid x:Name="NetDiagChecksGrid" MinHeight="185" MaxHeight="260">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Result" Width="76">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Background="{Binding BadgeBg}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Status}" Foreground="{Binding BadgeFg}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Diagnostic Step" Binding="{Binding Step}" Width="190"/>
                  <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>

          <!-- Adapters Table -->
          <Border Style="{StaticResource CardBorder}" Padding="12">
            <StackPanel>
              <TextBlock Text="DETECTED NETWORK ADAPTERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
              <DataGrid x:Name="NetAdaptersGrid" MinHeight="160" MaxHeight="240">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="150"/>
                  <DataGridTextColumn Header="Type" Binding="{Binding AdapterKind}" Width="82"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="88"/>
                  <DataGridTextColumn Header="Mode" Binding="{Binding ModeLabel}" Width="66"/>
                  <DataGridTextColumn Header="IPv4 Address" Binding="{Binding IpAddress}" Width="125"/>
                  <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="120"/>
                  <DataGridTextColumn Header="DNS Servers" Binding="{Binding DnsSummary}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ==================== VIEW 3: DRIVE SENTINEL ==================== -->
      <Grid x:Name="DrivesView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="245"/>
        </Grid.RowDefinitions>

        <!-- Metrics + Scan Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <UniformGrid Columns="4" Margin="0,0,12,0">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="PHYSICAL DRIVES" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                <TextBlock x:Name="DriveMetricTotal" Text="0" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="HEALTHY" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                <TextBlock x:Name="DriveMetricHealthy" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Success}" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="ATTENTION / RISK" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                <TextBlock x:Name="DriveMetricRisk" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Danger}" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8">
              <StackPanel>
                <TextBlock Text="PEAK TEMP" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                <TextBlock x:Name="DriveMetricMaxTemp" Text="—" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBright}" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <Button x:Name="DriveScanBtn" Grid.Column="1" Content="Scan Drives Now" Style="{StaticResource SolidAccentButtonStyle}" VerticalAlignment="Center" Click="DriveScanBtn_Click"/>
        </Grid>

        <!-- Physical Drives Table -->
        <DataGrid x:Name="DrivesGrid" Grid.Row="1" SelectionChanged="DrivesGrid_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Status" Width="96">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding Prediction.BadgeBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Prediction.BadgeText}" Foreground="{Binding Prediction.BadgeForeground}" FontSize="10" FontWeight="Bold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Disk" Binding="{Binding DiskIndex, StringFormat='Disk {0}'}" Width="60"/>
            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
            <DataGridTextColumn Header="Media / Bus" Binding="{Binding MediaType}" Width="125"/>
            <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="78"/>
            <DataGridTextColumn Header="Score" Binding="{Binding HealthScoreLabel}" Width="62"/>
            <DataGridTextColumn Header="Temp" Binding="{Binding TemperatureLabel}" Width="62"/>
            <DataGridTextColumn Header="Life" Binding="{Binding LifeRemainingLabel}" Width="58"/>
            <DataGridTextColumn Header="Volumes" Binding="{Binding VolumesSummary}" Width="170"/>
            <DataGridTextColumn Header="Risk Summary" Binding="{Binding KeyRiskSummary}" Width="210"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Selected Drive SMART & Events Detail -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
              <TextBlock x:Name="SelectedDriveTitle" Text="Select a drive above to inspect SMART / NVMe telemetry, wear life, and storage events." FontWeight="SemiBold" FontSize="13.5"/>
              <TextBlock x:Name="SelectedDriveDetail" Text="" Foreground="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TabControl Grid.Row="1">
              <TabItem Header="SMART / NVMe Attributes">
                <DataGrid x:Name="DriveSmartGrid" Margin="0,6,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="48"/>
                    <DataGridTextColumn Header="Attribute" Binding="{Binding Name}" Width="220"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding RawDisplay}" Width="165"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Impact" Binding="{Binding Impact}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
              <TabItem Header="Storage Event Log (30d)">
                <DataGrid x:Name="DriveEventsGrid" Margin="0,6,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="140"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="54"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="76"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>

      <!-- ==================== VIEW 4: DRIVERS, DEVICES, REPOS & STORE ==================== -->
      <TabControl x:Name="DriversSubTabs" Grid.Row="1" Visibility="Collapsed">
        <!-- SUB-TAB 1: DRIVER UPDATES -->
        <TabItem x:Name="UpdatesTabItem" Header="Driver Updates">
          <Grid Margin="0,10,0,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Source:" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="UpdateSourceFilter" Width="195" SelectionChanged="UpdateSourceFilter_SelectionChanged">
                  <ComboBoxItem Content="All Sources" IsSelected="True"/>
                  <ComboBoxItem Content="Windows Update &amp; MS Catalog"/>
                  <ComboBoxItem Content="Direct Manufacturer"/>
                  <ComboBoxItem Content="Custom Repositories"/>
                </ComboBox>
                <CheckBox x:Name="ChkIncludeOlderVersions" Content="Show Older / Rollback" Margin="10,0,0,0" IsChecked="True" Checked="UpdateSourceFilter_SelectionChanged" Unchecked="UpdateSourceFilter_SelectionChanged"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ScanWuaOnlyBtn" Content="Scan WU / Catalog" Click="ScanWuaOnlyBtn_Click" Margin="0,0,6,0"/>
                <Button x:Name="ScanDirectAndReposBtn" Content="Scan Direct &amp; Repos" Click="ScanDirectAndReposBtn_Click" Margin="0,0,6,0"/>
                <Button x:Name="InstallSelectedUpdatesBtn" Content="Install Selected" Style="{StaticResource SuccessButton}" Click="InstallSelectedUpdatesBtn_Click"/>
              </StackPanel>
            </Grid>

            <DataGrid x:Name="UpdatesGrid" Grid.Row="1" IsReadOnly="False" RowHeight="36" SelectionChanged="UpdatesGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="125" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Target Version (Choose Any)" Width="240">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox ItemsSource="{Binding Versions}"
                                SelectedItem="{Binding SelectedVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                DisplayMemberPath="PickerLabel"
                                FontSize="12"
                                Padding="6,3"
                                SelectionChanged="VersionPicker_SelectionChanged"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Source" Width="122" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Background="{Binding SourceBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SourceLabel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="68" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="SelectedUpdateTitle" Text="Select an update above to inspect release notes, matched Hardware ID, and install method." FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock x:Name="SelectedUpdateDetail" Text="Click 'Check Driver Updates' to query Windows Update, NVIDIA live API, and enabled repositories." Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button x:Name="PinUpdateDeviceBtn" Content="Pin Current Version" Click="PinUpdateDeviceBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button x:Name="OpenUpdateUrlBtn" Content="Open Download / Portal" Click="OpenUpdateUrlBtn_Click" IsEnabled="False"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <!-- SUB-TAB 2: DEVICES -->
        <TabItem Header="Devices">
          <Grid Margin="0,10,0,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="170"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="DeviceSearchBox" Margin="0,0,8,0" TextChanged="DeviceFilter_Changed" ToolTip="Search by device name, vendor, Hardware ID, or INF"/>
              <ComboBox x:Name="DeviceCategoryFilter" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="DeviceFilter_Changed">
                <ComboBoxItem Content="All Categories" IsSelected="True"/>
                <ComboBoxItem Content="Display"/>
                <ComboBoxItem Content="Network"/>
                <ComboBoxItem Content="Audio"/>
                <ComboBoxItem Content="Bluetooth"/>
                <ComboBoxItem Content="Storage &amp; NVMe"/>
                <ComboBoxItem Content="Chipset &amp; System"/>
                <ComboBoxItem Content="USB"/>
                <ComboBoxItem Content="Input &amp; HID"/>
                <ComboBoxItem Content="Security &amp; Firmware"/>
              </ComboBox>
              <ComboBox x:Name="DeviceStatusFilter" Grid.Column="2" SelectionChanged="DeviceFilter_Changed">
                <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                <ComboBoxItem Content="Problems Only"/>
                <ComboBoxItem Content="Updates Available"/>
                <ComboBoxItem Content="Inbox Generic"/>
                <ComboBoxItem Content="OEM Customized"/>
                <ComboBoxItem Content="Aged (&gt;2 yrs)"/>
              </ComboBox>
            </Grid>

            <DataGrid x:Name="DevicesGrid" Grid.Row="1" SelectionChanged="DevicesGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Status" Width="76">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Device Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="115"/>
                <DataGridTextColumn Header="Provider" Binding="{Binding DriverProvider}" Width="125"/>
                <DataGridTextColumn Header="Version" Binding="{Binding DriverVersion}" Width="115"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DriverDateText}" Width="88"/>
                <DataGridTextColumn Header="Smart Source" Binding="{Binding EffectiveSourceLabel}" Width="140"/>
                <DataGridTextColumn Header="INF" Binding="{Binding InfName}" Width="90"/>
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="InspectorDeviceTitle" Text="Select a device above to inspect Hardware IDs, OEM Subsystem ID, and download options." FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock x:Name="InspectorDeviceMeta" Grid.Column="1" Foreground="{StaticResource AccentBright}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="InspectorRationale" Grid.Row="1" Text="" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8"/>
                <WrapPanel Grid.Row="2">
                  <Button x:Name="DevMsCatalogBtn" Content="Search MS Update Catalog (HWID)" Click="DevMsCatalogBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button x:Name="DevOemBtn" Content="Open OEM Support Portal" Click="DevOemBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button x:Name="DevDirectBtn" Content="Open Direct Manufacturer" Click="DevDirectBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button x:Name="DevBackupBtn" Content="Backup This Driver (INF)" Click="DevBackupBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button x:Name="DevPinBtn" Content="Pin Current Version" Click="DevPinBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button x:Name="DevCopyHwidBtn" Content="Copy Hardware ID" Click="DevCopyHwidBtn_Click" IsEnabled="False"/>
                </WrapPanel>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <!-- SUB-TAB 3: REPOSITORIES -->
        <TabItem Header="Repositories">
          <Grid Margin="0,10,0,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="ADD CUSTOM DRIVER REPOSITORY (JSON URL, GITHUB RAW, OR LOCAL DRIVER FOLDER)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="NewRepoNameBox" Margin="0,0,8,0"/>
                  <TextBox x:Name="NewRepoUrlBox" Grid.Column="1" Margin="0,0,8,0"/>
                  <Button x:Name="BrowseRepoBtn" Grid.Column="2" Content="Browse..." Click="BrowseRepoBtn_Click" Margin="0,0,8,0"/>
                  <Button x:Name="AddRepoBtn" Grid.Column="3" Content="Add Repository" Style="{StaticResource PrimaryButton}" Click="AddRepoBtn_Click"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Public &amp; OEM Presets:" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                  <ComboBox x:Name="RepoPresetCombo" Grid.Column="1" Margin="0,0,8,0"/>
                  <Button x:Name="AddPresetRepoBtn" Grid.Column="2" Content="Add Preset Repo" Click="AddPresetRepoBtn_Click"/>
                </Grid>
              </StackPanel>
            </Border>

            <DataGrid x:Name="ReposGrid" Grid.Row="1" IsReadOnly="False">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="44"/>
                <DataGridTextColumn Header="Repository Name" Binding="{Binding Name}" Width="240" IsReadOnly="True"/>
                <DataGridTextColumn Header="URL / Path" Binding="{Binding UrlOrPath}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Packages" Binding="{Binding PackageCount}" Width="78" IsReadOnly="True"/>
                <DataGridTextColumn Header="Last Synced" Binding="{Binding LastSyncedText}" Width="125" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding LastStatus}" Width="150" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ExportSampleRepoBtn" Content="Export Sample manifest.json" Click="ExportSampleRepoBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="RemoveRepoBtn" Content="Remove Selected Repo" Style="{StaticResource DangerButton}" Click="RemoveRepoBtn_Click"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveAndSyncReposBtn" Content="Save &amp; Sync Repositories" Style="{StaticResource PrimaryButton}" Click="SaveAndSyncReposBtn_Click"/>
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <!-- SUB-TAB 4: DRIVER STORE & LOG -->
        <TabItem Header="Driver Store &amp; Log">
          <Grid Margin="0,10,0,4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="170"/>
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,4">
              <Button x:Name="BackupAllDriversBtn" Content="Backup All 3rd-Party Drivers" Style="{StaticResource PrimaryButton}" Click="BackupAllDriversBtn_Click" Margin="0,0,8,6"/>
              <Button x:Name="ExportOfflinePackBtn" Content="Export Portable Offline Pack" Click="ExportOfflinePackBtn_Click" Margin="0,0,8,6"/>
              <Button x:Name="RestoreBackupBtn" Content="Restore / Rollback Backup..." Click="RestoreBackupBtn_Click" Margin="0,0,8,6"/>
              <Button x:Name="InstallLocalDriverBtn" Content="Install Local INF / CAB / ZIP..." Style="{StaticResource SuccessButton}" Click="InstallLocalDriverBtn_Click" Margin="0,0,8,6"/>
              <Button x:Name="DeleteStorePkgBtn" Content="Delete Selected Stale Package" Style="{StaticResource DangerButton}" Click="DeleteStorePkgBtn_Click" Margin="0,0,8,6"/>
              <Button x:Name="CleanAllStaleBtn" Content="Clean All Stale Packages" Style="{StaticResource DangerButton}" Click="CleanAllStaleBtn_Click" Margin="0,0,8,6"/>
              <Button x:Name="ViewHistoryBtn" Content="Install History" Click="ViewHistoryBtn_Click" Margin="0,0,8,6"/>
              <Button x:Name="OpenBackupsFolderBtn" Content="Open Backups Folder" Click="OpenBackupsFolderBtn_Click" Margin="0,0,8,6"/>
              <Button x:Name="RefreshStoreBtn" Content="Refresh Driver Store" Click="RefreshStoreBtn_Click" Margin="0,0,0,6"/>
            </WrapPanel>

            <DataGrid x:Name="DriverStoreGrid" Grid.Row="1">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="State" Width="74">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Background="{Binding StateBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding StateBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Published" Binding="{Binding PublishedName}" Width="90"/>
                <DataGridTextColumn Header="Original INF" Binding="{Binding OriginalName}" Width="150"/>
                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="160"/>
                <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="125"/>
                <DataGridTextColumn Header="Version" Binding="{Binding DriverVersion}" Width="120"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="90"/>
                <DataGridTextColumn Header="Signer" Binding="{Binding SignerName}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="EXECUTION &amp; SECURITY AUDIT LOG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="#121214" BorderBrush="{StaticResource PanelBorder}" Padding="8"/>
              </Grid>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>

      <!-- ==================== VIEW 5: TELEMETRY & DEBLOAT ==================== -->
      <Grid x:Name="TelemetryView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="135"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TelemetrySearchBox" Margin="0,0,8,0" TextChanged="TelemetryFilter_Changed" ToolTip="Search services, tasks, registry policies, startup items, or Appx bloat"/>
          <ComboBox x:Name="TelemetryCategoryFilter" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="TelemetryFilter_Changed">
            <ComboBoxItem Content="All Categories" IsSelected="True"/>
            <ComboBoxItem Content="Service"/>
            <ComboBoxItem Content="Scheduled Task"/>
            <ComboBoxItem Content="Registry Policy"/>
            <ComboBoxItem Content="Startup"/>
            <ComboBoxItem Content="Appx Bloat"/>
          </ComboBox>
          <ComboBox x:Name="TelemetryRiskFilter" Grid.Column="2" Margin="0,0,8,0" SelectionChanged="TelemetryFilter_Changed">
            <ComboBoxItem Content="All Risks" IsSelected="True"/>
            <ComboBoxItem Content="Safe"/>
            <ComboBoxItem Content="Moderate"/>
            <ComboBoxItem Content="Optional"/>
          </ComboBox>
          <ComboBox x:Name="TelemetryStatusFilter" Grid.Column="3" SelectionChanged="TelemetryFilter_Changed">
            <ComboBoxItem Content="All Statuses" IsSelected="True"/>
            <ComboBoxItem Content="Active / Installed"/>
            <ComboBoxItem Content="Hardened / Removed"/>
          </ComboBox>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,4">
          <Button x:Name="TelSelectSafeBtn" Content="Select Safe Active" Click="TelSelectSafeBtn_Click" Margin="0,0,8,6"/>
          <Button x:Name="TelSelectAllActiveBtn" Content="Select All Active" Click="TelSelectAllActiveBtn_Click" Margin="0,0,8,6"/>
          <Button x:Name="TelClearSelBtn" Content="Clear Selection" Click="TelClearSelBtn_Click" Margin="0,0,8,6"/>
          <Button x:Name="TelDisableSelectedBtn" Content="Disable / Remove Selected" Style="{StaticResource DangerButton}" Click="TelDisableSelectedBtn_Click" Margin="0,0,8,6"/>
          <Button x:Name="TelRestoreSelectedBtn" Content="Restore Selected" Style="{StaticResource SuccessButton}" Click="TelRestoreSelectedBtn_Click" Margin="0,0,8,6"/>
          <Button x:Name="TelRescanBtn" Content="Rescan Telemetry &amp; Bloat" Click="TelRescanBtn_Click" Margin="0,0,0,6"/>
        </WrapPanel>

        <DataGrid x:Name="TelemetryGrid" Grid.Row="2" IsReadOnly="False" RowHeight="34">
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Sel" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
            <DataGridTemplateColumn Header="State" Width="82" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding StateBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding StateBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Category" Binding="{Binding CategoryLabel}" Width="105" IsReadOnly="True"/>
            <DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True"/>
            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="105" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Risk" Width="76" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding RiskBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding RiskLabel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="140" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Action" Width="84" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{Binding ActionButtonLabel}" Padding="8,2" FontSize="11" Click="TelRowActionBtn_Click" Tag="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- ==================== VIEW 6: LIVE OUTBOUND MONITOR ==================== -->
      <Grid x:Name="LiveMonitorView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox x:Name="MonitorSearchBox" Width="210" Margin="0,0,10,0" TextChanged="MonitorFilter_Changed" ToolTip="Filter by process, IP, hostname, or reason"/>
            <CheckBox x:Name="ChkMonitorFlaggedOnly" Content="Suspected Telemetry Only" IsChecked="False" Checked="MonitorFilter_Changed" Unchecked="MonitorFilter_Changed" Margin="0,0,12,0"/>
            <TextBlock x:Name="MonitorStatsText" Text="Monitoring live outbound TCP connections..." Foreground="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="MonitorPauseBtn" Content="Pause" Click="MonitorPauseBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="MonitorRefreshBtn" Content="Refresh Now" Click="MonitorRefreshBtn_Click"/>
          </StackPanel>
        </Grid>

        <DataGrid x:Name="LiveConnectionsGrid" Grid.Row="1" RowHeight="34">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Flag" Width="76">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding FlagBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding FlagLabel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="140"/>
            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="58"/>
            <DataGridTextColumn Header="Remote IP" Binding="{Binding RemoteAddress}" Width="125"/>
            <DataGridTextColumn Header="Port" Binding="{Binding RemotePort}" Width="55"/>
            <DataGridTextColumn Header="Hostname / Reason" Binding="{Binding RemoteHost}" Width="*"/>
            <DataGridTextColumn Header="Telemetry Note" Binding="{Binding TelemetryReason}" Width="180"/>
            <DataGridTemplateColumn Header="Firewall" Width="115">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{Binding FirewallButtonLabel}" IsEnabled="{Binding CanFirewallBlock}" Padding="8,2" FontSize="11" Click="MonitorFirewallBtn_Click" Tag="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Proc" Width="62">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Kill" Style="{StaticResource DangerButton}" Padding="8,2" FontSize="11" Click="MonitorKillBtn_Click" Tag="{Binding}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- ==================== VIEW 7: POWER PLAN ==================== -->
      <Grid x:Name="PowerView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Active Plan: " Foreground="{StaticResource MutedText}" FontSize="12"/>
                <TextBlock x:Name="PowerActivePlanBadgeText" Text="Detecting..." FontWeight="SemiBold" Foreground="{StaticResource Success}" FontSize="12"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="PowerHeaderHint" Text="Enforced natively via Windows powercfg." Foreground="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PowerRefreshBtn" Content="Re-Scan Power" Click="PowerRefreshBtn_Click" Margin="0,0,8,0"/>
            <Button x:Name="PowerQuickApplyBtn" Content="Generate &amp; Apply" Style="{StaticResource SolidAccentButtonStyle}" Click="PowerApplyBtn_Click"/>
          </StackPanel>
        </Grid>

        <TabControl x:Name="PowerSubTabs" Grid.Row="1" SelectionChanged="PowerSubTabs_SelectionChanged">
          <TabItem Header="Hardware &amp; Audit">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,12">
              <StackPanel>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                  <Border Style="{StaticResource CardBorder}" Margin="0,0,6,6">
                    <StackPanel>
                      <TextBlock Text="CPU &amp; ARCHITECTURE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                      <TextBlock x:Name="PowerHwCpuText" Text="Detecting..." FontSize="14" FontWeight="SemiBold" Margin="0,5,0,2" TextWrapping="Wrap"/>
                      <TextBlock x:Name="PowerHwCpuDetailText" Text="" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="6,0,0,6">
                    <StackPanel>
                      <TextBlock Text="GRAPHICS &amp; iGPU STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                      <TextBlock x:Name="PowerHwGpuText" Text="Detecting..." FontSize="14" FontWeight="SemiBold" Margin="0,5,0,2" TextWrapping="Wrap"/>
                      <TextBlock x:Name="PowerHwGpuDetailText" Text="" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="0,6,6,0">
                    <StackPanel>
                      <TextBlock Text="STORAGE &amp; BUS TOPOLOGY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                      <TextBlock x:Name="PowerHwStorageText" Text="Detecting..." FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardBorder}" Margin="6,6,0,0">
                    <StackPanel>
                      <TextBlock Text="PLATFORM, SLEEP &amp; xTaskForge" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                      <TextBlock x:Name="PowerHwPlatformText" Text="Detecting..." FontSize="12" Margin="0,5,0,2" TextWrapping="Wrap"/>
                      <TextBlock x:Name="PowerHwSleepText" Text="" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <Border Style="{StaticResource CardBorder}">
                  <StackPanel>
                    <Grid Margin="0,0,0,10">
                      <TextBlock Text="SMART AUDIT OF CURRENT ACTIVE PLAN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="PowerAuditSummaryText" HorizontalAlignment="Right" Foreground="{StaticResource MutedText}" FontSize="12"/>
                    </Grid>
                    <ItemsControl x:Name="PowerAuditList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{StaticResource DrawerBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                              </Border>
                              <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                  <TextBlock Text="{Binding Category, StringFormat='  •  {0}'}" Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Tune &amp; Options">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,12">
              <StackPanel>
                <TextBlock Text="CHOOSE A HARDWARE-TUNED PRESET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="2,0,0,8"/>
                <UniformGrid Columns="4" Margin="0,0,0,14">
                  <Button x:Name="PresetDevBtn" Click="PresetDevBtn_Click" Margin="0,0,6,0" Padding="12" HorizontalContentAlignment="Left">
                    <StackPanel>
                      <TextBlock Text="Smart Dev &amp; AI" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Snappy boost, cool idle, S3 sleep." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="PresetPerfBtn" Click="PresetPerfBtn_Click" Margin="3,0,3,0" Padding="12" HorizontalContentAlignment="Left">
                    <StackPanel>
                      <TextBlock Text="Max Performance" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Aggressive boost, EPP 0%, zero PCIe sleep." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="PresetQuietBtn" Click="PresetQuietBtn_Click" Margin="3,0,3,0" Padding="12" HorizontalContentAlignment="Left">
                    <StackPanel>
                      <TextBlock Text="Cool &amp; Quiet" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Lower fan noise &amp; heat, EPP 55%." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="PresetCustomBtn" Click="PresetCustomBtn_Click" Margin="6,0,0,0" Padding="12" HorizontalContentAlignment="Left">
                    <StackPanel>
                      <TextBlock Text="Custom" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="Manual control over every parameter." Foreground="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Button>
                </UniformGrid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <StackPanel>
                        <TextBlock Text="SLEEP, DISPLAY &amp; xTaskForge INTEGRATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Turn off display after (min, 0 = Never)" VerticalAlignment="Center"/>
                          <TextBox x:Name="PowerDisplayOffBox" Grid.Column="1" TextChanged="PowerOptionChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Put computer to sleep after (min, 0 = Never)" VerticalAlignment="Center"/>
                          <TextBox x:Name="PowerSleepAfterBox" Grid.Column="1" TextChanged="PowerOptionChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Hibernate after (min, 0 = Never)" VerticalAlignment="Center"/>
                          <TextBox x:Name="PowerHibernateAfterBox" Grid.Column="1" TextChanged="PowerOptionChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Wake Timers" VerticalAlignment="Center"/>
                          <ComboBox x:Name="PowerWakeTimersCombo" Grid.Column="1" SelectionChanged="PowerOptionChanged">
                            <ComboBoxItem Content="Disable (No phantom wakes)" Tag="0"/>
                            <ComboBoxItem Content="Enable All" Tag="1"/>
                            <ComboBoxItem Content="Important Wake Timers Only" Tag="2"/>
                          </ComboBox>
                        </Grid>
                        <CheckBox x:Name="PowerRespectMediaCheck" Content="Respect xTaskForge &amp; Media Keep-Awake" Margin="0,0,0,6" Checked="PowerOptionChanged" Unchecked="PowerOptionChanged"/>
                        <CheckBox x:Name="PowerRequirePassCheck" Content="Require password on wakeup from sleep" Margin="0,0,0,6" Checked="PowerOptionChanged" Unchecked="PowerOptionChanged"/>
                        <CheckBox x:Name="PowerAllowHybridCheck" Content="Allow Hybrid Sleep" Checked="PowerOptionChanged" Unchecked="PowerOptionChanged"/>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                      <StackPanel>
                        <TextBlock Text="PLAN MANAGEMENT &amp; SAFETY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                        <TextBlock Text="Power Plan Name" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="PowerPlanNameBox" Margin="0,0,0,10" TextChanged="PowerOptionChanged"/>
                        <CheckBox x:Name="PowerReusePlanCheck" Content="Reuse a single managed power plan" Margin="0,0,0,6" Checked="PowerOptionChanged" Unchecked="PowerOptionChanged"/>
                        <CheckBox x:Name="PowerBackupPrevCheck" Content="Auto-backup previous active plan (.pow)" Margin="0,0,0,6" Checked="PowerOptionChanged" Unchecked="PowerOptionChanged"/>
                        <CheckBox x:Name="PowerUnhideAdvancedCheck" Content="Unhide Boost Mode, EPP &amp; NVMe in Control Panel" Checked="PowerOptionChanged" Unchecked="PowerOptionChanged"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                      <StackPanel>
                        <TextBlock Text="CPU TUNING (AMD RYZEN / CPPC2)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Boost Mode" VerticalAlignment="Center"/>
                          <ComboBox x:Name="PowerBoostModeCombo" Grid.Column="1" SelectionChanged="PowerOptionChanged">
                            <ComboBoxItem Content="Disabled (Base clock)" Tag="0"/>
                            <ComboBoxItem Content="Enabled" Tag="1"/>
                            <ComboBoxItem Content="Aggressive" Tag="2"/>
                            <ComboBoxItem Content="Efficient Enabled" Tag="3"/>
                            <ComboBoxItem Content="Efficient Aggressive" Tag="4"/>
                          </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Energy Perf Pref (EPP)" VerticalAlignment="Center"/>
                          <Slider x:Name="PowerEppSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="PowerOptionChanged"/>
                          <TextBlock x:Name="PowerEppValueText" Grid.Column="2" Text="20%" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Min Processor State" VerticalAlignment="Center"/>
                          <Slider x:Name="PowerMinCpuSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="PowerOptionChanged"/>
                          <TextBlock x:Name="PowerMinCpuValueText" Grid.Column="2" Text="5%" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Max Processor State" VerticalAlignment="Center"/>
                          <Slider x:Name="PowerMaxCpuSlider" Grid.Column="1" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="PowerOptionChanged"/>
                          <TextBlock x:Name="PowerMaxCpuValueText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Core Parking Min Cores" VerticalAlignment="Center"/>
                          <Slider x:Name="PowerCoreParkingSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="PowerOptionChanged"/>
                          <TextBlock x:Name="PowerCoreParkingValueText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                          <TextBlock Text="System Cooling Policy" VerticalAlignment="Center"/>
                          <ComboBox x:Name="PowerCoolingCombo" Grid.Column="1" SelectionChanged="PowerOptionChanged">
                            <ComboBoxItem Content="Passive (Throttle first)" Tag="0"/>
                            <ComboBoxItem Content="Active (Fan first)" Tag="1"/>
                          </ComboBox>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                      <StackPanel>
                        <TextBlock Text="GPU, PCIe, STORAGE &amp; USB TUNING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                          <TextBlock Text="PCIe Link State Power Mgmt" VerticalAlignment="Center"/>
                          <ComboBox x:Name="PowerPcieCombo" Grid.Column="1" SelectionChanged="PowerOptionChanged">
                            <ComboBoxItem Content="Off (Lowest latency)" Tag="0"/>
                            <ComboBoxItem Content="Moderate power savings" Tag="1"/>
                            <ComboBoxItem Content="Maximum power savings" Tag="2"/>
                          </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                          <TextBlock Text="SATA AHCI Link Power Mgmt" VerticalAlignment="Center"/>
                          <ComboBox x:Name="PowerAhciCombo" Grid.Column="1" SelectionChanged="PowerOptionChanged">
                            <ComboBoxItem Content="Active (Zero SSD stutter)" Tag="0"/>
                            <ComboBoxItem Content="HIPM" Tag="1"/>
                            <ComboBoxItem Content="HIPM + DIPM" Tag="2"/>
                          </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="8"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
                          <TextBlock Text="NVMe Idle / Lat Tol (ms)" VerticalAlignment="Center"/>
                          <TextBox x:Name="PowerNvmeIdleBox" Grid.Column="1" TextChanged="PowerOptionChanged"/>
                          <TextBox x:Name="PowerNvmeLatBox" Grid.Column="3" TextChanged="PowerOptionChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Turn off hard disk after (min)" VerticalAlignment="Center"/>
                          <TextBox x:Name="PowerDiskOffBox" Grid.Column="1" TextChanged="PowerOptionChanged"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
                          <TextBlock Text="USB 3 Link Power Mgmt" VerticalAlignment="Center"/>
                          <ComboBox x:Name="PowerUsb3Combo" Grid.Column="1" SelectionChanged="PowerOptionChanged">
                            <ComboBoxItem Content="Off (Best for USB drives)" Tag="0"/>
                            <ComboBoxItem Content="Minimum" Tag="1"/>
                            <ComboBoxItem Content="Moderate" Tag="2"/>
                            <ComboBoxItem Content="Maximum" Tag="3"/>
                          </ComboBox>
                        </Grid>
                        <CheckBox x:Name="PowerUsbSuspendCheck" Content="Enable USB Selective Suspend" Checked="PowerOptionChanged" Unchecked="PowerOptionChanged"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Diff &amp; Enforce">
            <Grid Margin="0,12,0,4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="130"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="PowerDiffSummaryText" Text="Comparing current active plan against configured target..." Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Button x:Name="PowerEnforceBtn" HorizontalAlignment="Right" Content="Generate, Apply &amp; Verify" Style="{StaticResource SuccessButton}" Click="PowerApplyBtn_Click"/>
              </Grid>
              <DataGrid x:Name="PowerDiffGrid" Grid.Row="1" Margin="0,0,0,10">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="95"/>
                  <DataGridTextColumn Header="Windows Power Setting" Binding="{Binding SettingName}" Width="240"/>
                  <DataGridTextColumn Header="Current Active" Binding="{Binding CurrentValue}" Width="145"/>
                  <DataGridTextColumn Header="Target Value" Binding="{Binding TargetValue}" Width="155"/>
                  <DataGridTemplateColumn Header="Delta" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="ENFORCEMENT &amp; VERIFICATION LOG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,4"/>
                  <TextBox x:Name="PowerLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" BorderThickness="0" Background="#121214"/>
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="Manage Windows Plans">
            <Grid Margin="0,12,0,4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Switch, export .pow backups, or remove unused Windows power plans." Foreground="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Set Selected Active" Style="{StaticResource PrimaryButton}" Click="PowerSetActivePlanBtn_Click" Margin="0,0,8,0"/>
                  <Button Content="Export .pow Backup" Click="PowerExportPlanBtn_Click" Margin="0,0,8,0"/>
                  <Button Content="Delete Selected" Style="{StaticResource DangerButton}" Click="PowerDeletePlanBtn_Click"/>
                </StackPanel>
              </Grid>
              <DataGrid x:Name="PowerPlansGrid" Grid.Row="1">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Status" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ActiveBadge}" Foreground="{StaticResource Success}" FontWeight="Bold" FontSize="11"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Power Plan Name" Binding="{Binding Name}" Width="340"/>
                  <DataGridTextColumn Header="Scheme GUID" Binding="{Binding Guid}" Width="310"/>
                  <DataGridCheckBoxColumn Header="Windows Built-In" Binding="{Binding IsBuiltIn, Mode=OneWay}" Width="125"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>

      <!-- ==================== VIEW 8: CONTEXT & STARTUP ==================== -->
      <Grid x:Name="ContextView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ContextSearchBox" Margin="0,0,8,0" ToolTip="Search context menu names, commands, startup items, or registry paths" TextChanged="ContextSearchBox_TextChanged"/>
          <ComboBox x:Name="ContextLocationFilter" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="ContextLocationFilter_SelectionChanged">
            <ComboBoxItem Content="All locations" IsSelected="True"/>
            <ComboBoxItem Content="Installed applications"/>
            <ComboBoxItem Content="Installed apps (Missing files)"/>
            <ComboBoxItem Content="Startup items (All)"/>
            <ComboBoxItem Content="Startup (Registry)"/>
            <ComboBoxItem Content="Startup (Folders)"/>
            <ComboBoxItem Content="Win+X menu"/>
            <ComboBoxItem Content="File context menu"/>
            <ComboBoxItem Content="Folder context menu"/>
            <ComboBoxItem Content="Folder background"/>
            <ComboBoxItem Content="Drive context menu"/>
            <ComboBoxItem Content="Desktop background"/>
          </ComboBox>
          <Button x:Name="ContextRefreshBtn" Grid.Column="2" Content="Scan Again" Click="ContextRefresh_Click" Margin="0,0,8,0"/>
          <Button x:Name="ContextRestartExplorerBtn" Grid.Column="3" Content="Restart Explorer" ToolTip="Restart Windows Explorer to apply Win+X changes" Click="ContextRestartExplorer_Click"/>
        </Grid>

        <DataGrid x:Name="ContextEntriesGrid" Grid.Row="1" MouseDoubleClick="ContextEntriesGrid_MouseDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
            <DataGridTextColumn Header="Menu Location" Binding="{Binding Location}" Width="2*"/>
            <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="128"/>
            <DataGridTemplateColumn Header="Status" Width="105">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding StatusBadgeBg}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Command / Target" Binding="{Binding Command}" Width="3*"/>
          </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ContextStatusText" Text="Scanning context menus, startup items, Win+X, and installed apps..." Foreground="{StaticResource AppText}" FontSize="12"/>
            <TextBlock Text="All edits, toggles, and deletions are automatically backed up to JSON before applying." Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Edit" Click="ContextEdit_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"/>
            <Button Content="Backup" Click="ContextBackup_Click" Margin="0,0,6,0"/>
            <Button Content="Restore Backup" Click="ContextRestore_Click" Margin="0,0,6,0"/>
            <Button Content="Enable" Click="ContextEnable_Click" Style="{StaticResource SuccessButton}" Margin="0,0,6,0"/>
            <Button Content="Disable" Click="ContextDisable_Click" Margin="0,0,6,0"/>
            <Button Content="Delete" Click="ContextDelete_Click" Style="{StaticResource DangerButton}"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Footer Status Bar -->
      <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusFooterText" Text="Ready." Foreground="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="MainProgressBar" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
