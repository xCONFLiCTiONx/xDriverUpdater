<Window x:Class="xDriverUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xDriverUpdater — Smart Windows Driver Manager"
        Icon="pack://application:,,,/xDriverUpdater;component/icon.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        Width="920" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Grid Background="{StaticResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#161920" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="xDriverUpdater" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="SMART DRIVER MANAGER" FontSize="10" FontWeight="SemiBold" Foreground="#60A5FA"/>
            </Border>
            <Border x:Name="FormFactorPill" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="FormFactorPillText" Text="DETECTING..." FontSize="10" FontWeight="SemiBold" Foreground="#A7F3D0"/>
            </Border>
          </StackPanel>
          <TextBlock x:Name="HeaderSubtitle" Text="Inspecting system hardware, OEM subsystem IDs, and installed drivers..." Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RescanHwBtn" Content="Re-Scan Hardware" Click="RescanHwBtn_Click" Margin="0,0,8,0"/>
          <Button x:Name="ScanUpdatesBtn" Content="Check Updates (All Sources)" Style="{StaticResource PrimaryButton}" Click="ScanUpdatesBtn_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Tabs -->
    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,10,16,0">

      <!-- TAB 1: OVERVIEW & SMART AUDIT -->
      <TabItem Header="Overview &amp; Smart Audit">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,12">
          <StackPanel>
            <!-- 4 Summary Cards -->
            <UniformGrid Columns="2" Margin="0,0,0,12">
              <Border Style="{StaticResource CardBorder}" Margin="0,0,6,6">
                <StackPanel>
                  <TextBlock Text="PLATFORM &amp; OEM IDENTITY" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                  <TextBlock x:Name="CardPlatformTitle" Text="Detecting..." FontSize="14" FontWeight="SemiBold" Margin="0,5,0,2" TextWrapping="Wrap"/>
                  <TextBlock x:Name="CardPlatformDetail" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <Button x:Name="OpenOemPortalBtn" Content="Open OEM Support Portal" Click="OpenOemPortalBtn_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" FontSize="11"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorder}" Margin="6,0,0,6">
                <StackPanel>
                  <TextBlock Text="DRIVER INVENTORY &amp; HEALTH" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                  <TextBlock x:Name="CardHealthTitle" Text="Scanning..." FontSize="14" FontWeight="SemiBold" Margin="0,5,0,2" TextWrapping="Wrap"/>
                  <TextBlock x:Name="CardHealthDetail" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorder}" Margin="0,6,6,0">
                <StackPanel>
                  <TextBlock Text="UPDATE SOURCES (DUAL-MODE ENGINE)" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                  <CheckBox x:Name="ChkUseWua" Content="Windows Update (Exact Device Manager WHQL Channel)" Margin="0,7,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                  <CheckBox x:Name="ChkUseDirect" Content="Direct Manufacturer Checks (NVIDIA Live API / Vendor Portals)" Margin="0,0,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                  <CheckBox x:Name="ChkUseRepos" Content="Custom &amp; Built-In Repositories (JSON Feeds / Local Folders)" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorder}" Margin="6,6,0,0">
                <StackPanel>
                  <TextBlock Text="SMART OEM GUARD &amp; SAFETY" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                  <CheckBox x:Name="ChkPreferLaptopOem" Content="Prefer OEM / WU drivers on Laptops (protects Acer/Dell/Lenovo GPUs)" Margin="0,7,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                  <CheckBox x:Name="ChkRestorePoint" Content="Create Windows System Restore Point before installing" Margin="0,0,0,4" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                  <CheckBox x:Name="ChkAutoBackup" Content="Auto-backup current OEM INF driver before replacing" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- Scheduled Silent Updates & xSecurity Alerts Card -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="SCHEDULED SILENT UPDATES &amp; xSECURITY ALERTS" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ScheduledTaskStatusText" HorizontalAlignment="Right" Text="Checking Windows Task Scheduler..." Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Frequency" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="SchedFreqCombo">
                      <ComboBoxItem Content="Daily" IsSelected="True"/>
                      <ComboBoxItem Content="Weekly"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Time (24h)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="SchedTimeBox" Text="03:00" ToolTip="24-hour time in HH:mm format (e.g. 03:00)"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="xServer xSecurity Events Endpoint" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="XSecurityUrlBox" ToolTip="xSecurity events ingest URL (notifies xSecurity module &amp; broadcasts toast alerts to all connected devices)"/>
                  </StackPanel>
                </Grid>

                <CheckBox x:Name="ChkLocalToastOnFailure" Content="Also show local Windows toast notification on failure (in addition to xServer/xSecurity broadcast to all connected devices)" Margin="0,0,0,10" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed"/>

                <WrapPanel>
                  <Button x:Name="RegisterTaskBtn" Content="Save &amp; Register Scheduled Task" Style="{StaticResource PrimaryButton}" Click="RegisterTaskBtn_Click" Margin="0,0,8,4"/>
                  <Button x:Name="RunSilentNowBtn" Content="Run Silent Update Now" Style="{StaticResource SuccessButton}" Click="RunSilentNowBtn_Click" Margin="0,0,8,4"/>
                  <Button x:Name="TestAlertBtn" Content="Test xSecurity Alert" Click="TestAlertBtn_Click" Margin="0,0,8,4"/>
                  <Button x:Name="OpenLogsFolderBtn" Content="Open Logs Folder" Click="OpenLogsFolderBtn_Click" Margin="0,0,8,4"/>
                  <Button x:Name="RemoveTaskBtn" Content="Remove Task" Style="{StaticResource DangerButton}" Click="RemoveTaskBtn_Click" Margin="0,0,0,4"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- Smart Audit Findings -->
            <Border Style="{StaticResource CardBorder}">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <TextBlock Text="SMART DRIVER &amp; OEM AUDIT" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                  <TextBlock x:Name="AuditSummaryText" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                </Grid>

                <ItemsControl x:Name="AuditList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#14171E" BorderBrush="#262C38" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                          </Border>
                          <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                              <TextBlock Text="{Binding Category, StringFormat='  •  {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- TAB 2: UPDATES AVAILABLE -->
      <TabItem x:Name="UpdatesTabItem" Header="Updates Available">
        <Grid Margin="0,10,0,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Toolbar -->
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Source:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="UpdateSourceFilter" Width="195" SelectionChanged="UpdateSourceFilter_SelectionChanged">
                <ComboBoxItem Content="All Sources" IsSelected="True"/>
                <ComboBoxItem Content="Windows Update &amp; MS Catalog"/>
                <ComboBoxItem Content="Direct Manufacturer"/>
                <ComboBoxItem Content="Custom Repositories"/>
              </ComboBox>
              <CheckBox x:Name="ChkIncludeOlderVersions" Content="Show Older / Rollback" Margin="10,0,0,0" IsChecked="True" Checked="UpdateSourceFilter_SelectionChanged" Unchecked="UpdateSourceFilter_SelectionChanged" ToolTip="Keep devices visible even when already on the latest version so you can pick an older/known-good version."/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="ScanWuaOnlyBtn" Content="Scan WU / Catalog" Click="ScanWuaOnlyBtn_Click" Margin="0,0,6,0"/>
              <Button x:Name="ScanDirectAndReposBtn" Content="Scan Direct &amp; Repos" Click="ScanDirectAndReposBtn_Click" Margin="0,0,6,0"/>
              <Button x:Name="InstallSelectedUpdatesBtn" Content="Install Selected" Style="{StaticResource SuccessButton}" Click="InstallSelectedUpdatesBtn_Click"/>
            </StackPanel>
          </Grid>

          <!-- Updates Grid (1 row per device + Interactive Target Version Picker!) -->
          <DataGrid x:Name="UpdatesGrid" Grid.Row="1" IsReadOnly="False" RowHeight="36" SelectionChanged="UpdatesGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
              <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Installed" Binding="{Binding InstalledVersion}" Width="125" IsReadOnly="True"/>
              <DataGridTemplateColumn Header="Target Version (Choose Any)" Width="240">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="PickerLabel"
                              FontSize="12"
                              Padding="6,3"
                              SelectionChanged="VersionPicker_SelectionChanged"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Source" Width="122" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{Binding SourceBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding SourceLabel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="68" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Selected Update Detail Card -->
          <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="SelectedUpdateTitle" Text="Select an update above to inspect release notes, matched Hardware ID, and install method." FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="SelectedUpdateDetail" Text="Tip: Click 'Check Updates (All Sources)' to query Windows Update (Device Manager channel), NVIDIA official servers, and all enabled repositories." Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="OpenUpdateUrlBtn" Content="Open Download / Portal" Click="OpenUpdateUrlBtn_Click" IsEnabled="False"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 3: ALL DEVICES & DRIVERS -->
      <TabItem Header="All Devices &amp; Drivers">
        <Grid Margin="0,10,0,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Filter Bar -->
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DeviceSearchBox" Margin="0,0,8,0" TextChanged="DeviceFilter_Changed" ToolTip="Search by device name, vendor, Hardware ID, or INF"/>
            <ComboBox x:Name="DeviceCategoryFilter" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="DeviceFilter_Changed">
              <ComboBoxItem Content="All Categories" IsSelected="True"/>
              <ComboBoxItem Content="Display"/>
              <ComboBoxItem Content="Network"/>
              <ComboBoxItem Content="Audio"/>
              <ComboBoxItem Content="Bluetooth"/>
              <ComboBoxItem Content="Storage &amp; NVMe"/>
              <ComboBoxItem Content="Chipset &amp; System"/>
              <ComboBoxItem Content="USB"/>
              <ComboBoxItem Content="Input &amp; HID"/>
              <ComboBoxItem Content="Security &amp; Firmware"/>
            </ComboBox>
            <ComboBox x:Name="DeviceStatusFilter" Grid.Column="2" SelectionChanged="DeviceFilter_Changed">
              <ComboBoxItem Content="All Statuses" IsSelected="True"/>
              <ComboBoxItem Content="Problems Only"/>
              <ComboBoxItem Content="Updates Available"/>
              <ComboBoxItem Content="Inbox Generic"/>
              <ComboBoxItem Content="OEM Customized"/>
              <ComboBoxItem Content="Aged (&gt;2 yrs)"/>
            </ComboBox>
          </Grid>

          <!-- Devices Grid -->
          <DataGrid x:Name="DevicesGrid" Grid.Row="1" SelectionChanged="DevicesGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Status" Width="76">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Device Name" Binding="{Binding DisplayName}" Width="*"/>
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="115"/>
              <DataGridTextColumn Header="Provider" Binding="{Binding DriverProvider}" Width="125"/>
              <DataGridTextColumn Header="Version" Binding="{Binding DriverVersion}" Width="115"/>
              <DataGridTextColumn Header="Date" Binding="{Binding DriverDateText}" Width="88"/>
              <DataGridTextColumn Header="Smart Source" Binding="{Binding EffectiveSourceLabel}" Width="140"/>
              <DataGridTextColumn Header="INF" Binding="{Binding InfName}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Device Smart Inspector Panel -->
          <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InspectorDeviceTitle" Text="Select a device above to inspect Hardware IDs, OEM Subsystem ID, and download options." FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="InspectorDeviceMeta" Grid.Column="1" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="InspectorRationale" Grid.Row="1" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <WrapPanel Grid.Row="2">
                <Button x:Name="DevMsCatalogBtn" Content="Search MS Update Catalog (HWID)" Click="DevMsCatalogBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="DevOemBtn" Content="Open OEM Support Portal" Click="DevOemBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="DevDirectBtn" Content="Open Direct Manufacturer" Click="DevDirectBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="DevBackupBtn" Content="Backup This Driver (INF)" Click="DevBackupBtn_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="DevCopyHwidBtn" Content="Copy Hardware ID" Click="DevCopyHwidBtn_Click" IsEnabled="False"/>
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 4: EXTENSIBLE REPOSITORIES -->
      <TabItem Header="Repositories">
        <Grid Margin="0,10,0,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Add Repository Card -->
          <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="ADD CUSTOM DRIVER REPOSITORY (JSON URL, GITHUB RAW, R2 / xSERVER, OR LOCAL DRIVER FOLDER)" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="210"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewRepoNameBox" Margin="0,0,8,0" ToolTip="Repository Name (e.g. My Acer Laptop Repo)"/>
                <TextBox x:Name="NewRepoUrlBox" Grid.Column="1" Margin="0,0,8,0" ToolTip="https://.../manifest.json OR local folder path C:\Drivers"/>
                <Button x:Name="BrowseRepoBtn" Grid.Column="2" Content="Browse..." Click="BrowseRepoBtn_Click" Margin="0,0,8,0"/>
                <Button x:Name="AddRepoBtn" Grid.Column="3" Content="Add Repository" Style="{StaticResource PrimaryButton}" Click="AddRepoBtn_Click"/>
              </Grid>
              <TextBlock Text="Tip: Point to any HTTPS JSON manifest OR a local/network folder full of .inf drivers (xDriverUpdater auto-indexes Hardware IDs!)." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <!-- Repositories Grid -->
          <DataGrid x:Name="ReposGrid" Grid.Row="1" IsReadOnly="False">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="44"/>
              <DataGridTextColumn Header="Repository Name" Binding="{Binding Name}" Width="240" IsReadOnly="True"/>
              <DataGridTextColumn Header="URL / Path" Binding="{Binding UrlOrPath}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Packages" Binding="{Binding PackageCount}" Width="78" IsReadOnly="True"/>
              <DataGridTextColumn Header="Last Synced" Binding="{Binding LastSyncedText}" Width="125" IsReadOnly="True"/>
              <DataGridTextColumn Header="Status" Binding="{Binding LastStatus}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Repo Actions -->
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
              <Button x:Name="ExportSampleRepoBtn" Content="Export Sample manifest.json" Click="ExportSampleRepoBtn_Click" Margin="0,0,8,0"/>
              <Button x:Name="RemoveRepoBtn" Content="Remove Selected Repo" Style="{StaticResource DangerButton}" Click="RemoveRepoBtn_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="SaveAndSyncReposBtn" Content="Save &amp; Sync Repositories" Style="{StaticResource PrimaryButton}" Click="SaveAndSyncReposBtn_Click"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- TAB 5: DRIVER STORE, BACKUP & LOG -->
      <TabItem Header="Driver Store, Backup &amp; Log">
        <Grid Margin="0,10,0,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="175"/>
          </Grid.RowDefinitions>

          <!-- Actions Bar -->
          <WrapPanel Grid.Row="0" Margin="0,0,0,4">
            <Button x:Name="BackupAllDriversBtn" Content="Backup All 3rd-Party Drivers" Style="{StaticResource PrimaryButton}" Click="BackupAllDriversBtn_Click" Margin="0,0,8,6"/>
            <Button x:Name="InstallLocalDriverBtn" Content="Install Local INF / CAB / ZIP..." Style="{StaticResource SuccessButton}" Click="InstallLocalDriverBtn_Click" Margin="0,0,8,6"/>
            <Button x:Name="DeleteStorePkgBtn" Content="Delete Selected Stale Package" Style="{StaticResource DangerButton}" Click="DeleteStorePkgBtn_Click" Margin="0,0,8,6"/>
            <Button x:Name="CleanAllStaleBtn" Content="Clean All Stale Packages" Style="{StaticResource DangerButton}" Click="CleanAllStaleBtn_Click" Margin="0,0,8,6" ToolTip="Remove all superseded, inactive (STALE) third-party OEM driver packages from the Windows Driver Store."/>
            <Button x:Name="OpenBackupsFolderBtn" Content="Open Backups Folder" Click="OpenBackupsFolderBtn_Click" Margin="0,0,8,6"/>
            <Button x:Name="RefreshStoreBtn" Content="Refresh Driver Store" Click="RefreshStoreBtn_Click" Margin="0,0,0,6"/>
          </WrapPanel>

          <!-- Driver Store Grid -->
          <DataGrid x:Name="DriverStoreGrid" Grid.Row="1">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="State" Width="74">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Background="{Binding StateBadgeColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding StateBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Published" Binding="{Binding PublishedName}" Width="90"/>
              <DataGridTextColumn Header="Original INF" Binding="{Binding OriginalName}" Width="150"/>
              <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="160"/>
              <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="125"/>
              <DataGridTextColumn Header="Version" Binding="{Binding DriverVersion}" Width="120"/>
              <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="90"/>
              <DataGridTextColumn Header="Signer" Binding="{Binding SignerName}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Execution Log -->
          <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="EXECUTION &amp; AUDIT LOG" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,6"/>
              <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       TextWrapping="NoWrap" Background="#0D1016" BorderBrush="#262C38" Padding="8"/>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Footer Status Bar -->
    <Border Grid.Row="2" Background="#161920" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusFooterText" Text="Ready." Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
        <ProgressBar x:Name="MainProgressBar" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
      </Grid>
    </Border>
  </Grid>
</Window>
